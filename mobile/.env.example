# Vercel (or local) origin, no trailing slash.
# Example: https://your-project.vercel.app
# You can also type this on first launch; it is saved on the phone.
EXPO_PUBLIC_API_URL=

# Optional. The app reads the Clerk publishable key from GET /api/config
# on that server. Set this only if you want to override that response.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
