{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{tests/**,docs/**,data/**,web/**,.agents/**,**/*.md}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/items/:id/similar", "destination": "/api/item-similar?id=:id" },
    { "source": "/api/items/:id", "destination": "/api/item?id=:id" }
  ]
}
