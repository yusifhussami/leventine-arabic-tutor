# Copy this file to .env and put the OpenRouter key there.
# .env is ignored by git. Leave this example blank.
OPENROUTER_API_KEY=

# GEMINI_API_KEY is read as the same key, if that is the name you already use.

# Hosted deploy (Vercel + Supabase). Leave blank for local SQLite.
# Dashboard → Connect → Transaction pooler (port 6543). Use that URI for
# local and Vercel — direct db.*.supabase.co is IPv6-only and many networks
# (and Vercel) cannot reach it. Do not wrap the password in brackets.
DATABASE_URL=
CLERK_PUBLISHABLE_KEY=
CLERK_JWKS_URL=
